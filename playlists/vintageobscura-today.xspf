  <trackList>
    <track>
      <title>Don't Want To Know [UK, Pop] (1960)</title>
      <creator>Michael Cox and Joe Meek</creator>
      <image>https://vintageobscura.net/yt_img/JPRnMiXsFmo.jpg</image>
      <album>Recent Discoveries</album>
    </track>
    <track>
      <title>The Three Ravens [USA, Folk] ( 1974): A album by family of puppeteers documenting the songs from their show. The record evokes a time when children's stories and songs could be genuinely spooky and brings to my mind the English folk horror portrayed by films like The Wicker Man.</title>
      <creator>The Dildine Family</creator>
      <image>https://vintageobscura.net/yt_img/bFkNeU1DObU.jpg</image>
      <album>Recent Discoveries</album>
    </track>
    <track>
      <title>Sanatorium (サナトリウム) [Japan, psychedelic folk] (1982)</title>
      <creator>Doji Morita [森田童子]</creator>
      <image>https://vintageobscura.net/yt_img/uSZ-DM4y2QI.jpg</image>
      <album>Recent Discoveries</album>
    </track>
    <track>
      <title>Cream [Jazz/fusion, Denmark] (1977)</title>
      <creator>Entrance</creator>
      <image>https://vintageobscura.net/yt_img/Uj8MUNjnZJc.jpg</image>
      <album>Recent Discoveries</album>
    </track>
    <track>
      <title>Go Monster Go [USA, garage/film soundtrack] (1965)</title>
      <creator>The Other Three</creator>
      <image>https://vintageobscura.net/yt_img/mqByMiG5cMk.jpg</image>
      <album>Recent Discoveries</album>
