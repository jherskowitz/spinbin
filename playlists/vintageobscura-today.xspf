      <album>Obscure Covers</album>
    </track>
    <track>
      <title>Carry On [USA, Psyche, Rock] (1981): Fantastic, psychedelic and massively joyful cover of the Crosby, Stills, Nash &amp; Young classic from this talented high school band. This 4 track E.P. rules.</title>
      <creator>Old Mill Folk Rock Group</creator>
      <image>https://vintageobscura.net/yt_img/5aZrj0RJRgI.jpg</image>
      <album>Obscure Covers</album>
    </track>
